# Core Runtime
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-32-plus-char-random-secret-in-production"
ALLOW_DEMO_MODE="true"

# PostgreSQL (Neon / Managed Postgres). When omitted locally, ReleaseDocket uses embedded SQLite (.data/releasedocket.sqlite).
DATABASE_URL="postgresql://user:password@host:5432/releasedocket?sslmode=require"

# Read-Only GitHub App (Installation + Webhooks)
GITHUB_APP_ID=""
GITHUB_APP_SLUG="releasedocket-app"
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Optional GitHub OAuth (User Login - separate from GitHub App installation)
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# Stripe Billing & Webhooks
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SOLO=""
STRIPE_PRICE_STUDIO=""
STRIPE_PRICE_AGENCY=""
STRIPE_PRICE_PARTNER=""

# Email Delivery Adapter (Optional Resend API; defaults to DB outbox log when omitted)
RESEND_API_KEY=""
EMAIL_FROM="receipts@releasedocket.example"

# Gemini AI Adapter (Server-side only; core product operates without AI keys via deterministic draft fallback)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
